# ==============================================================================
# Tasker Mobile App - Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in the values for your environment.
# Variables prefixed with EXPO_PUBLIC_ are bundled into client-side JS.
# NEVER put private server secrets (database passwords, private API keys) here!
# ==============================================================================

# Backend API Configuration
EXPO_PUBLIC_BACKEND_URL=https://api.taskercompany.cloud
EXPO_PUBLIC_STORAGE_URL=https://api.taskercompany.cloud/storage

# Laravel Reverb (WebSockets) Configuration
EXPO_PUBLIC_REVERB_SCHEME=https
EXPO_PUBLIC_REVERB_HOST=api.taskercompany.cloud
EXPO_PUBLIC_REVERB_PORT=443
EXPO_PUBLIC_REVERB_KEY=your_reverb_app_key_here
EXPO_PUBLIC_REVERB_APP_KEY=your_reverb_app_key_here

# Real-time WebSocket Feature Flag (true / false)
EXPO_PUBLIC_ENABLE_REALTIME=true

# Google Maps Platform API Key (Restricted to Android/iOS bundle IDs)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# App Debugging (0 = disabled in production, 1 = enabled)
EXPO_PUBLIC_ENABLE_APP_DEBUG=0
