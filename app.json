{
  "expo": {
    "name": "Tasker Company",
    "slug": "tasker-company",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icons/adaptive-icon.png",
    "scheme": "tasker-company",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:taskercompany.com",
        "applinks:www.taskercompany.com",
        "applinks:taskercompany.com/orders/*",
        "applinks:www.taskercompany.com/orders/*",
        "applinks:taskercompany.com/services/*",
        "applinks:www.taskercompany.com/services/*",
        "applinks:taskercompany.com/categories/*",
        "applinks:www.taskercompany.com/categories/*",
        "applinks:taskercompany.com/schedule",
        "applinks:www.taskercompany.com/schedule",
        "applinks:taskercompany.com/track",
        "applinks:www.taskercompany.com/track",
        "applinks:taskercompany.com/chat/*",
        "applinks:www.taskercompany.com/chat/*"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "monochromeImage": "./assets/icons/adaptive-icon.png"
      },
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.taskercompany.company",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "taskercompany.com",
              "pathPrefix": "/orders"
            },
            {
              "scheme": "https",
              "host": "www.taskercompany.com",
              "pathPrefix": "/orders"
            },
            {
              "scheme": "https",
              "host": "taskercompany.com",
              "pathPrefix": "/services"
            },
            {
              "scheme": "https",
              "host": "www.taskercompany.com",
              "pathPrefix": "/services"
            },
            {
              "scheme": "https",
              "host": "taskercompany.com",
              "pathPrefix": "/categories"
            },
            {
              "scheme": "https",
              "host": "www.taskercompany.com",
              "pathPrefix": "/categories"
            },
            {
              "scheme": "https",
              "host": "taskercompany.com",
              "pathPrefix": "/schedule"
            },
            {
              "scheme": "https",
              "host": "www.taskercompany.com",
              "pathPrefix": "/schedule"
            },
            {
              "scheme": "https",
              "host": "taskercompany.com",
              "pathPrefix": "/track"
            },
            {
              "scheme": "https",
              "host": "www.taskercompany.com",
              "pathPrefix": "/track"
            },
            {
              "scheme": "https",
              "host": "taskercompany.com",
              "pathPattern": "/chat/*"
            },
            {
              "scheme": "https",
              "host": "www.taskercompany.com",
              "pathPattern": "/chat/*"
            },
            {
              "scheme": "tasker-company",
              "host": "*"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/adaptive-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon-dark.png",
          "imageWidth": 200,
          "resizeMode": "cover",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-maps",
      "expo-video",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4408fc40-2932-4da5-9fc6-77ea2457a8da"
      }
    },
    "owner": "tasker-company",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4408fc40-2932-4da5-9fc6-77ea2457a8da"
    }
  }
}
