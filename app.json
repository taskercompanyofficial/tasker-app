{
  "expo": {
    "name": "Tasker Company",
    "slug": "tasker-company",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icons/adaptive-icon.png",
    "scheme": "tasker-company",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskercompany.company",
      "config": {
        "googleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY_HERE"
      },
      "associatedDomains": [
        "applinks:taskercompany.com",
        "applinks:www.taskercompany.com",
        "applinks:taskercompany.com/orders/*",
        "applinks:www.taskercompany.com/orders/*",
        "applinks:taskercompany.com/services/*",
        "applinks:www.taskercompany.com/services/*",
        "applinks:taskercompany.com/categories/*",
        "applinks:www.taskercompany.com/categories/*",
        "applinks:taskercompany.com/schedule",
        "applinks:www.taskercompany.com/schedule",
        "applinks:taskercompany.com/track",
        "applinks:www.taskercompany.com/track",
        "applinks:taskercompany.com/chat/*",
        "applinks:www.taskercompany.com/chat/*"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Tasker requires camera access to scan your CNIC identity documents and capture biometric selfie photos for verification.",
        "NSPhotoLibraryUsageDescription": "Tasker requires photo library access so you can upload your CNIC card photos and portfolio images.",
        "NSPhotoLibraryAddUsageDescription": "Tasker requires permission to save receipts and scanned documents.",
        "NSLocationWhenInUseUsageDescription": "Tasker requires access to your location to find nearby customer service requests and provide turn-by-turn navigation.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Tasker requires background location access to share live real-time location updates with customers while you are on the way to a job.",
        "NSLocationAlwaysUsageDescription": "Tasker requires background location access to update customers on your arrival status even when the app is in background.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification",
          "processing"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "monochromeImage": "./assets/icons/adaptive-icon.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY_HERE"
        }
      },
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "package": "com.taskercompany.company",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "taskercompany.com",
              "pathPrefix": "/orders"
            },
            {
              "scheme": "https",
              "host": "www.taskercompany.com",
              "pathPrefix": "/orders"
            },
            {
              "scheme": "https",
              "host": "taskercompany.com",
              "pathPrefix": "/services"
            },
            {
              "scheme": "https",
              "host": "www.taskercompany.com",
              "pathPrefix": "/services"
            },
            {
              "scheme": "https",
              "host": "taskercompany.com",
              "pathPrefix": "/categories"
            },
            {
              "scheme": "https",
              "host": "www.taskercompany.com",
              "pathPrefix": "/categories"
            },
            {
              "scheme": "https",
              "host": "taskercompany.com",
              "pathPrefix": "/schedule"
            },
            {
              "scheme": "https",
              "host": "www.taskercompany.com",
              "pathPrefix": "/schedule"
            },
            {
              "scheme": "https",
              "host": "taskercompany.com",
              "pathPrefix": "/track"
            },
            {
              "scheme": "https",
              "host": "www.taskercompany.com",
              "pathPrefix": "/track"
            },
            {
              "scheme": "https",
              "host": "taskercompany.com",
              "pathPattern": "/chat/*"
            },
            {
              "scheme": "https",
              "host": "www.taskercompany.com",
              "pathPattern": "/chat/*"
            },
            {
              "scheme": "tasker-company",
              "host": "*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "geo"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "maps.google.com"
            },
            {
              "scheme": "https",
              "host": "www.google.com",
              "pathPrefix": "/maps"
            },
            {
              "scheme": "https",
              "host": "maps.app.goo.gl"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/adaptive-icon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Tasker Vendor to track live location in the background for active customer work order navigation.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tasker to use the camera to scan CNIC documents and capture verification photos."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon-dark.png",
          "imageWidth": 200,
          "resizeMode": "cover",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-maps",
      "expo-video",
      "expo-audio",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      "expo-sharing",
      "react-native-document-scanner-plugin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4408fc40-2932-4da5-9fc6-77ea2457a8da"
      }
    },
    "owner": "tasker-company",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4408fc40-2932-4da5-9fc6-77ea2457a8da"
    }
  }
}
